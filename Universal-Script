local function new(class_name, properties, parent)
	local object = Instance.new(class_name)

	for property, value in pairs(properties or {}) do
		object[property] = value
	end

	object.Parent = parent

	return object
end

local function tween(object, duration, properties, style, direction)
	local info = TweenInfo.new(
		duration,
		style or Enum.EasingStyle.Quint,
		direction or Enum.EasingDirection.Out
	)

	return tween_service:Create(object, info, properties)
end

local function round(object, radius)
	new("UICorner", {
		CornerRadius = UDim.new(0, radius)
	}, object)
end

local function stroke(object, transparency, thickness)
	new("UIStroke", {
		Color = Color3.fromRGB(255, 255, 255),
		Transparency = transparency,
		Thickness = thickness
	}, object)
end

local function gradient(object, color1, color2, transparency1, transparency2)
	return new("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, color1),
			ColorSequenceKeypoint.new(1, color2)
		}),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, transparency1),
			NumberSequenceKeypoint.new(1, transparency2)
		})
	}, object)
end

