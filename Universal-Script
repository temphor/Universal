		exit_center = camera.ViewportSize / 2
	else
		exit_center = Vector2.new(960, 540)
	end

	for index, data in ipairs(particles) do
		local direction = data.position - exit_center

		if direction.Magnitude < 1 then
			direction = Vector2.new(
				math.cos(index),
				math.sin(index)
			)
		end

		direction = direction.Unit

		local side = Vector2.new(
			-direction.Y,
			direction.X
		)

		data.velocity =
			direction * math.random(280, 520)
			+ side * math.random(-180, 180)

