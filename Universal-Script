local render_connection

render_connection = run_service.RenderStepped:Connect(function(delta_time)
	if not screen.Parent then
		render_connection:Disconnect()
		return
	end

	local elapsed = os.clock() - start_time
	local progress_value = math.clamp(
		elapsed / loading_time,
		0,
		1
	)

	if not finishing then
		percentage.Text = math.floor(progress_value * 100) .. "%"

		status.Text = get_status(elapsed)

		time_label.Text = string.format(
			"%.1f / %.1f",
			math.min(elapsed, loading_time),
			loading_time
		)

		progress.Size = UDim2.fromScale(
			progress_value,
			1
		)

		local shine_x = progress_value - 0.12

		progress_shine.Position = UDim2.fromScale(
			shine_x,
			-1.8
		)
	end

	local pointer_difference =
		target_pointer - pointer_position

	pointer_velocity +=
		pointer_difference *
		math.min(delta_time * 35, 1)

	pointer_velocity *=
		math.exp(-delta_time * 10)

	pointer_position +=
		pointer_velocity *
		math.min(delta_time * 8, 1)

	pointer_light.Position = UDim2.fromOffset(
		pointer_position.X,
		pointer_position.Y
	)

	local viewport = camera and camera.ViewportSize

	if viewport then
		local width_scale = viewport.X / 650
		local height_scale = viewport.Y / 450

		local responsive_scale = math.clamp(
			math.min(width_scale, height_scale),
			0.7,
			1.12
		)

		if not finishing then
			glass_scale.Scale = responsive_scale
		end
	end

	if viewport then
		local center = viewport / 2

		local offset = pointer_position - center

		local normalized_x = math.clamp(
			offset.X / 1000,
			-1,
			1
		)

		local normalized_y = math.clamp(
			offset.Y / 1000,
			-1,
			1
		)

		if not finishing then
			glass.Position = UDim2.new(
				0.5,
				normalized_x * 7,
				0.5,
				normalized_y * 7
			)

			glass.Rotation = normalized_x * 0.6
		end
	end

	for _, data in ipairs(particles) do
		if data.exploding then
			data.velocity *= math.exp(-delta_time * 1.5)

			data.velocity += Vector2.new(
				0,
				18 * delta_time
			)

			data.position +=
				data.velocity * delta_time

			data.life -= delta_time * 1.7

			data.object.BackgroundTransparency =
				math.clamp(
					1 - data.life,
					0,
					1
				)

			local current_size =
				math.max(
					data.size * data.life,
					0.1
				)

			data.object.Size = UDim2.fromOffset(
				current_size,
				current_size
			)

			data.object.Position = UDim2.fromOffset(
				data.position.X,
				data.position.Y
			)
		else
			data.angle +=
				data.orbit_speed *
				delta_time

			local wobble =
				math.sin(
					os.clock() * 1.8 +
					data.phase
				) * data.wobble

			local desired_radius =
				data.radius +
				wobble

			local radial_direction =
				data.position -
				pointer_position

			if radial_direction.Magnitude < 1 then
				radial_direction = Vector2.new(1, 0)
			end

			radial_direction =
				radial_direction.Unit

			local tangent = Vector2.new(
				-radial_direction.Y,
				radial_direction.X
			)

			local orbit_target =
				pointer_position +
				radial_direction *
				desired_radius

			local spring =
				orbit_target -
				data.position

			data.velocity +=
				spring *
				data.spring_force *
				delta_time

			data.velocity +=
				tangent *
				data.orbit_force *
				delta_time

			data.velocity *=
				math.pow(
					data.damping,
					delta_time * 60
				)

			local max_speed = 260

			if data.velocity.Magnitude > max_speed then
				data.velocity =
					data.velocity.Unit *
					max_speed
			end

			data.position +=
				data.velocity *
				delta_time

			data.object.Position =
				UDim2.fromOffset(
					data.position.X,
					data.position.Y
				)

			local speed =
				data.velocity.Magnitude

			local transparency =
				math.clamp(
					0.8 - speed / 900,
					0.35,
					0.78
				)

			data.object.BackgroundTransparency =
				transparency
		end
	end

	if progress_value >= 1 and not finishing then
		task.spawn(finish_loading)
	end
end)
