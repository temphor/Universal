local function finish_loading()
	if finishing then
		return
	end

	finishing = true

	percentage.Text = "100%"
	status.Text = "Ready"
	connection.Text = "connected"
	time_label.Text = "15.0 / 15.0"

	progress.Size = UDim2.fromScale(1, 1)

